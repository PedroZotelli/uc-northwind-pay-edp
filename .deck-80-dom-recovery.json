"<!DOCTYPE html>\n<html lang=\"en\"><head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"color-scheme\" content=\"dark\">\n<meta name=\"description\" content=\"Dark Factory Operation — autonomous migration of a legacy financial system. Workshop deck.\">\n<title>Dark Factory Operation — Workshop</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2308080a'/%3E%3Cpath d='M16 6l7 10-7 10-7-10z' fill='%23a78bfa'/%3E%3C/svg%3E\">\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&amp;family=Fira+Code:wght@400;500;600;700&amp;family=Instrument+Serif:ital@0;1&amp;family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&amp;family=Space+Grotesk:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\n\n<style>\n/* ═══════════════════════════════════════════════════════════════════\n   OPERAÇÃO DARK FACTORY · DESIGN SYSTEM DO DECK\n   Fundação: tokens → atmosfera → layout → tipografia → chrome →\n   componentes-base → motion. Slides herdam tudo daqui.\n   ═══════════════════════════════════════════════════════════════════ */\n\n:root {\n  --bg: #08080a; --surface: #111114; --surface2: #19191e; --surface-elevated: #222228;\n  --border: rgba(120,160,220,0.08); --border-bright: rgba(120,160,220,0.18);\n  --text: #eaedf2; --text-dim: #6e7a8c;\n  --accent: #4a9eff; --accent-dim: rgba(74,158,255,0.10);   /* azul — Claude / piloto / mercado */\n  --silver: #b0bec5; --silver-bright: #cfd8dc;              /* prata — humano / neutro */\n  --silver-dim: rgba(176,190,197,0.10);\n  --gold: #d4af37; --gold-dim: rgba(212,175,55,0.10);       /* ouro — governança / bootcamp */\n  --green: #3fb950; --green-dim: rgba(63,185,80,0.10);      /* verde — eval / aceite / prova */\n  --red: #f85149; --red-dim: rgba(248,81,73,0.10);          /* vermelho — morte / tensão / gate */\n  --purple: #a78bfa; --purple-dim: rgba(167,139,250,0.10);  /* roxo — Kimi / loop / história */\n  --cyan: #22d3ee; --cyan-dim: rgba(34,211,238,0.10);       /* ciano — Codex / anatomia */\n  --orange: #ef9000; --orange-dim: rgba(239,144,0,0.10);\n  --code-bg: #060608; --code-text: #c8d0dc;\n  --font-display: 'Instrument Serif', Georgia, serif;\n  --font-editorial: 'Newsreader', Georgia, serif;\n  --font-body: 'DM Sans', system-ui, sans-serif;\n  --font-mono: 'Fira Code', 'SF Mono', Consolas, monospace;\n  --font-numeric: 'Space Grotesk', 'DM Sans', system-ui, sans-serif;  /* numerais de destaque */\n  --spring: cubic-bezier(0.32,0.72,0,1);\n  --ease-out-expo: cubic-bezier(0.16,1,0.3,1);\n  --drift: cubic-bezier(0.45,0.05,0.55,0.95);\n}\n\n/* ── reset & base ─────────────────────────────────────────────────── */\n* { margin: 0; padding: 0; box-sizing: border-box; }\nhtml { color-scheme: dark; }\nbody {\n  font-family: var(--font-body); color: var(--text); background: var(--bg);\n  overflow: hidden; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;\n}\n::selection { background: var(--accent); color: #000; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }\nimg, svg { max-width: 100%; display: block; }\nbutton { font: inherit; color: inherit; }\n\n/* film-grain — camada final sobre tudo */\nbody::after {\n  content: ''; position: fixed; inset: 0; z-index: 9999; pointer-events: none; opacity: 0.04;\n  background: url(\"data:image/svg+xml;base64,\");\n}\n\n/* ── ATMOSFERA — fundo vivo global (aurora fixa + grid-floor) ─────── */\n.atmosphere { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }\n\n/*  Aurora reutilizável — 3 orbes: ::before, ::after e um <b> filho.\n    Uso por slide:  <div class=\"aurora aurora--purple\" aria-hidden=\"true\"><b></b></div>  */\n.aurora {\n  position: absolute; inset: -12%; z-index: -1; pointer-events: none;\n  filter: blur(60px); opacity: 0.38; transition: opacity 1.4s ease;\n  --a1: rgba(74,158,255,0.16); --a2: rgba(34,211,238,0.09); --a3: rgba(167,139,250,0.10);\n}\n.atmosphere .aurora { z-index: 0; inset: -8%; opacity: 0.5; }\n.slide.is-active .aurora { opacity: 0.62; }\n.aurora::before, .aurora::after, .aurora > b {\n  content: ''; position: absolute; border-radius: 50%;\n  mix-blend-mode: screen; will-change: transform;\n}\n.aurora::before { width: 48vw; height: 48vw; left: -8%; top: -12%;  background: radial-gradient(circle, var(--a1), transparent 62%); animation: aurora-a 26s var(--drift) infinite alternate; }\n.aurora::after  { width: 38vw; height: 38vw; right: -5%; top: 16%;  background: radial-gradient(circle, var(--a2), transparent 62%); animation: aurora-b 34s var(--drift) infinite alternate; }\n.aurora > b     { width: 34vw; height: 34vw; left: 30%; bottom: -18%; background: radial-gradient(circle, var(--a3), transparent 62%); animation: aurora-c 40s var(--drift) infinite alternate; }\n@keyframes aurora-a { from { transform: translate3d(0,0,0) scale(1); }    to { transform: translate3d(7vw, 5vh, 0) scale(1.16); } }\n@keyframes aurora-b { from { transform: translate3d(0,0,0) scale(1.08); } to { transform: translate3d(-6vw, -4vh, 0) scale(0.94); } }\n@keyframes aurora-c { from { transform: translate3d(0,0,0) scale(0.96); } to { transform: translate3d(4vw, -6vh, 0) scale(1.12); } }\n\n/* tintas por acento — cada slide invoca a sua */\n.aurora--accent { --a1: rgba(74,158,255,0.18);  --a2: rgba(34,211,238,0.09);  --a3: rgba(176,190,197,0.08); }\n.aurora--gold   { --a1: rgba(212,175,55,0.16);  --a2: rgba(239,144,0,0.09);   --a3: rgba(74,158,255,0.07); }\n.aurora--red    { --a1: rgba(248,81,73,0.15);   --a2: rgba(239,144,0,0.09);   --a3: rgba(167,139,250,0.07); }\n.aurora--green  { --a1: rgba(63,185,80,0.15);   --a2: rgba(34,211,238,0.08);  --a3: rgba(74,158,255,0.07); }\n.aurora--purple { --a1: rgba(167,139,250,0.17); --a2: rgba(74,158,255,0.09);  --a3: rgba(34,211,238,0.07); }\n.aurora--cyan   { --a1: rgba(34,211,238,0.15);  --a2: rgba(74,158,255,0.10);  --a3: rgba(63,185,80,0.06); }\n.aurora--silver { --a1: rgba(176,190,197,0.13); --a2: rgba(207,216,220,0.08); --a3: rgba(74,158,255,0.06); }\n\n/* grid-floor — chão de linhas finas com máscara radial */\n.grid-floor {\n  position: absolute; left: 50%; bottom: -16%; width: 150%; height: 60%;\n  transform: translateX(-50%) perspective(1100px) rotateX(64deg); transform-origin: 50% 0%;\n  background-image:\n    linear-gradient(rgba(120,160,220,0.07) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(120,160,220,0.07) 1px, transparent 1px);\n  background-size: 56px 56px;\n  -webkit-mask-image: radial-gradient(ellipse 58% 90% at 50% 0%, #000 4%, transparent 68%);\n  mask-image: radial-gradient(ellipse 58% 90% at 50% 0%, #000 4%, transparent 68%);\n  pointer-events: none;\n}\n\n/* ── DECK / SLIDE ─────────────────────────────────────────────────── */\n.deck {\n  position: relative; z-index: 1;\n  height: 100dvh; overflow-y: auto;\n  scroll-snap-type: y mandatory; scroll-behavior: smooth;\n  scrollbar-width: none;\n}\n.deck::-webkit-scrollbar { display: none; }\n\n.slide {\n  height: 100dvh; scroll-snap-align: start; overflow: hidden; position: relative;\n  display: flex; flex-direction: column; justify-content: center;\n  padding: clamp(32px, 5vh, 56px) clamp(36px, 5vw, 88px);\n  isolation: isolate;\n}\n.slide--title {\n  justify-content: center; align-items: center; text-align: center;\n  background-image:\n    radial-gradient(ellipse at 50% 30%, rgba(74,158,255,0.12) 0%, transparent 50%),\n    radial-gradient(ellipse at 80% 80%, rgba(212,175,55,0.04) 0%, transparent 40%);\n}\n.slide--silent { justify-content: center; align-items: center; text-align: center; }\n\n/* respiração ambiente por slide + spotlight do apresentador */\n.slide::before {\n  content: ''; position: absolute; inset: 0; z-index: -2; pointer-events: none;\n  opacity: 0; transition: opacity 1.4s ease;\n  background:\n    radial-gradient(58% 50% at 28% 18%, rgba(74,158,255,0.05), transparent 68%),\n    radial-gradient(50% 46% at 82% 88%, rgba(212,175,55,0.03), transparent 70%);\n}\n.slide.is-active::before { opacity: 1; animation: ambient-drift 18s var(--drift) infinite; }\n.slide--title::before, .slide--silent::before { display: none; }\n@keyframes ambient-drift {\n  0%, 100% { transform: translate3d(0,0,0) scale(1); }\n  50%      { transform: translate3d(-2.5%, 1.5%, 0) scale(1.09); }\n}\n.slide::after {\n  content: ''; position: absolute; inset: 0; z-index: -2; pointer-events: none;\n  opacity: 0; transition: opacity 1s ease;\n  background: radial-gradient(760px circle at var(--mx, 50%) var(--my, 38%), rgba(140,180,255,0.07), transparent 62%);\n}\n.slide.is-active::after { opacity: 1; }\n\n/* ── ESCALA TIPOGRÁFICA ───────────────────────────────────────────── */\n.slide__display {\n  font-family: var(--font-display); font-size: clamp(56px, 10vw, 120px);\n  font-weight: 400; letter-spacing: -1px; line-height: 0.92; text-wrap: balance;\n}\n.slide__display--act { font-size: clamp(110px, 20vw, 280px); letter-spacing: -2px; }\n.slide__heading {\n  font-family: var(--font-display); font-size: clamp(36px, 6vw, 72px);\n  font-weight: 400; letter-spacing: -0.5px; line-height: 1.08; text-wrap: balance;\n}\n.slide__body {\n  font-family: var(--font-editorial); font-size: clamp(19px, 2.1vw, 25px);\n  line-height: 1.55; color: var(--text-dim); letter-spacing: 0.01em;\n}\n.slide__body b, .slide__body strong { color: var(--text); font-weight: 600; }\n.slide__label {\n  font-family: var(--font-mono); font-size: clamp(11px, 1.1vw, 14px); font-weight: 600;\n  text-transform: uppercase; letter-spacing: 2.5px; color: var(--accent); margin-bottom: 16px;\n}\n.slide__label.gold { color: var(--gold); }   .slide__label.green { color: var(--green); }\n.slide__label.red { color: var(--red); }     .slide__label.purple { color: var(--purple); }\n.slide__label.cyan { color: var(--cyan); }   .slide__label.silver { color: var(--silver); }\n.act-marker {\n  font-family: var(--font-mono); font-size: 11px; letter-spacing: 4px; text-transform: uppercase;\n  color: var(--text-dim); opacity: 0.7; margin-bottom: 8px;\n  display: inline-flex; align-items: center; gap: 14px;\n}\n.act-marker::before { content: ''; width: 26px; height: 1px; background: var(--text-dim); opacity: 0.6; }\n\n/* gradientes de texto para palavras-chave */\n.gradient-text   { background: linear-gradient(135deg, var(--accent) 0%, var(--silver-bright) 50%, #fff 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }\n.gradient-gold   { background: linear-gradient(135deg, var(--gold) 0%, #fff 50%, var(--accent) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }\n.gradient-red    { background: linear-gradient(135deg, var(--red) 0%, #fff 50%, var(--orange) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }\n.gradient-green  { background: linear-gradient(135deg, var(--green) 0%, #fff 60%, var(--green) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }\n.gradient-purple { background: linear-gradient(135deg, var(--purple) 0%, #fff 50%, var(--accent) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 0 24px rgba(167,139,250,0.10)); }\n\n/* ── CHROME DE NAVEGAÇÃO ──────────────────────────────────────────── */\n.deck-progress {\n  position: fixed; top: 0; left: 0; height: 3px; width: 0;\n  background: linear-gradient(90deg, var(--accent), var(--silver)); z-index: 100;\n  transition: width 0.3s var(--ease-out-expo); pointer-events: none;\n  box-shadow: 0 0 16px rgba(74,158,255,0.55), 0 0 4px rgba(255,255,255,0.4);\n  border-radius: 0 3px 3px 0;\n}\n.deck-progress::after {\n  content: ''; position: absolute; top: 50%; right: -1px; width: 7px; height: 7px;\n  border-radius: 50%; transform: translateY(-50%); background: #fff;\n  box-shadow: 0 0 14px 3px rgba(74,158,255,0.7);\n  opacity: 0; transition: opacity 0.3s ease;\n}\n.deck-progress.live::after { opacity: 1; }\n/* counter estampado — só os números, no registro do badge \"Dark Factory Operation\" */\n.deck-counter {\n  position: fixed; bottom: clamp(14px,2.2vh,26px); right: clamp(14px,2.2vw,28px); z-index: 100;\n  display: inline-flex; align-items: baseline;\n  font-family: var(--font-mono); font-size: 11.5px; font-weight: 800;\n  letter-spacing: 3px; text-transform: uppercase; color: #000;\n  padding: 7px 16px; border-radius: 5px;\n  background: var(--dc-c);\n  box-shadow: 0 6px 22px var(--dc-glow), 0 0 0 1px var(--dc-ring), inset 0 1px 0 rgba(255,255,255,0.3);\n  transition: background .6s var(--spring), box-shadow .6s var(--spring);\n  --dc-c: var(--purple); --dc-glow: rgba(167,139,250,0.4); --dc-ring: rgba(167,139,250,0.6);\n}\n.deck-counter::before { content: '\\25C6'; margin-right: 9px; opacity: 0.75; }\n.deck-counter::after  { content: '\\25C6'; margin-left: 9px; opacity: 0.75; }\n.dc-n { font-size: 13px; }\n.dc-sep { opacity: 0.55; margin: 0 5px; }\n.dc-tot { opacity: 0.75; }\n@keyframes counter-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }\n\n.deck-tracker {\n  position: fixed; top: 50%; right: clamp(10px, 1.2vw, 18px); transform: translateY(-50%);\n  display: flex; flex-direction: column; gap: 4px; padding: 10px 6px;\n  background: rgba(10,11,14,0.55); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);\n  border: 1px solid rgba(255,255,255,0.06); border-radius: 999px; z-index: 100;\n  max-height: min(85vh, 960px); overflow: hidden;\n}\n.deck-tracker:empty { display: none; }\n.deck-tracker .dot {\n  appearance: none; border: 0; padding: 0; display: block; cursor: pointer;\n  width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.18);\n  transition: background 0.25s var(--spring), height 0.25s var(--spring), transform 0.25s var(--spring);\n  flex: 0 0 auto;\n}\n.deck-tracker .dot:hover { background: rgba(255,255,255,0.45); transform: scale(1.35); }\n.deck-tracker .dot.passed { background: rgba(255,255,255,0.4); }\n.deck-tracker .dot.current {\n  height: 22px; border-radius: 3px; background: var(--accent);\n  box-shadow: 0 0 12px rgba(74,158,255,0.5); transform: none;\n}\n@media (max-width: 768px) { .deck-tracker { display: none; } }\n\n/* ── 1 · EYEBROW / HERO-BADGE — kickers ───────────────────────────── */\n.eyebrow {\n  display: inline-flex; align-items: center; gap: 10px;\n  font-family: var(--font-mono); font-size: 11px; font-weight: 600;\n  letter-spacing: 2.5px; text-transform: uppercase; color: var(--silver-bright);\n  padding: 8px 18px; border: 1px solid var(--border-bright); border-radius: 999px;\n  background: linear-gradient(180deg, rgba(255,255,255,0.04), transparent 70%), rgba(17,17,20,0.6);\n  box-shadow: 0 0 24px var(--eb-glow, var(--accent-dim)), inset 0 1px 0 rgba(255,255,255,0.06);\n}\n.eyebrow::before {\n  content: ''; width: 6px; height: 6px; border-radius: 50%;\n  background: var(--eb-c, var(--accent)); box-shadow: 0 0 10px var(--eb-c, var(--accent));\n}\n.eyebrow.gold   { --eb-c: var(--gold);   --eb-glow: var(--gold-dim); }\n.eyebrow.green  { --eb-c: var(--green);  --eb-glow: var(--green-dim); }\n.eyebrow.red    { --eb-c: var(--red);    --eb-glow: var(--red-dim); }\n.eyebrow.purple { --eb-c: var(--purple); --eb-glow: var(--purple-dim); }\n.eyebrow.cyan   { --eb-c: var(--cyan);   --eb-glow: var(--cyan-dim); }\n\n.hero-badge {\n  display: inline-block; background: var(--accent); color: #000;\n  font-family: var(--font-mono); font-size: 11px; font-weight: 800;\n  letter-spacing: 3px; text-transform: uppercase; padding: 7px 18px; border-radius: 5px;\n  box-shadow: 0 6px 22px rgba(74,158,255,0.4), 0 0 0 1px rgba(74,158,255,0.6), inset 0 1px 0 rgba(255,255,255,0.3);\n  margin-bottom: clamp(20px, 3.2vh, 36px);\n}\n.hero-badge::before { content: '\\25C6'; margin-right: 8px; opacity: 0.8; }\n.hero-badge::after  { content: '\\25C6'; margin-left: 8px; opacity: 0.8; }\n\n/* ── 2 · PILL — badge estampada, texto preto, glow por cor ────────── */\n.pill {\n  display: inline-block; padding: 7px 16px; border-radius: 5px;\n  font-family: var(--font-mono); font-size: 11px; font-weight: 800;\n  letter-spacing: 2px; text-transform: uppercase; color: #000;\n  background: var(--pill-c, var(--accent));\n  box-shadow: 0 5px 18px var(--pill-glow, rgba(74,158,255,0.35)), 0 0 0 1px var(--pill-ring, rgba(74,158,255,0.6)), inset 0 1px 0 rgba(255,255,255,0.3);\n}\n.pill::before { content: '\\25C6'; margin-right: 7px; opacity: 0.7; }\n.pill.accent { --pill-c: var(--accent); --pill-glow: rgba(74,158,255,0.4);  --pill-ring: rgba(74,158,255,0.6); }\n.pill.purple { --pill-c: var(--purple); --pill-glow: rgba(167,139,250,0.4); --pill-ring: rgba(167,139,250,0.6); }\n.pill.gold   { --pill-c: var(--gold);   --pill-glow: rgba(212,175,55,0.4);  --pill-ring: rgba(212,175,55,0.6); }\n.pill.green  { --pill-c: var(--green);  --pill-glow: rgba(63,185,80,0.4);   --pill-ring: rgba(63,185,80,0.6); }\n.pill.cyan   { --pill-c: var(--cyan);   --pill-glow: rgba(34,211,238,0.4);  --pill-ring: rgba(34,211,238,0.6); }\n.pill.red    { --pill-c: var(--red);    --pill-glow: rgba(248,81,73,0.4);   --pill-ring: rgba(248,81,73,0.6); }\n\n/* ── 3 · CARD — double-bezel: concha usinada + núcleo concêntrico ──\n   Uso:  <div class=\"card accent\"><div class=\"card-inner\">…</div></div> */\n.card {\n  position: relative; border-radius: 18px; padding: 6px;\n  background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.012) 45%, rgba(0,0,0,0.14)), var(--surface);\n  border: 1px solid var(--border);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 30px 60px -30px rgba(0,0,0,0.65);\n  transition: transform 0.55s var(--spring), box-shadow 0.55s var(--spring), border-color 0.55s var(--spring);\n  --card-c: var(--accent); --card-halo: rgba(74,158,255,0.16); --card-spot: rgba(140,180,255,0.09);\n}\n.card::before { /* borda-topo na cor — detalhe usinado */\n  content: ''; position: absolute; top: 0; left: 22px; right: 22px; height: 3px;\n  border-radius: 0 0 4px 4px; background: linear-gradient(90deg, transparent, var(--card-c) 30%, var(--card-c) 70%, transparent);\n  opacity: 0.9; z-index: 1;\n}\n.card::after { /* halo de canto */\n  content: ''; position: absolute; top: -70px; right: -70px; width: 240px; height: 240px;\n  border-radius: 50%; background: radial-gradient(circle, var(--card-halo), transparent 70%);\n  pointer-events: none; z-index: 0;\n}\n.card-inner {\n  position: relative; z-index: 1; height: 100%; overflow: hidden; border-radius: 13px;\n  background: linear-gradient(180deg, var(--surface2), var(--surface) 70%);\n  border: 1px solid rgba(255,255,255,0.045);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);\n  padding: clamp(18px, 2.4vh, 28px) clamp(18px, 1.6vw, 28px);\n}\n.card-inner::after { /* spotlight que segue o cursor (--px/--py via JS) */\n  content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0;\n  transition: opacity 0.5s var(--ease-out-expo);\n  background: radial-gradient(420px circle at var(--px, 50%) var(--py, 40%), var(--card-spot), transparent 65%);\n}\n.card:hover { transform: translateY(-5px) scale(1.008); border-color: var(--border-bright);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 22px 48px -18px rgba(0,0,0,0.55), 0 0 44px -8px var(--card-halo); }\n.card:hover .card-inner::after { opacity: 1; }\n.card:active { transform: translateY(-1px) scale(0.997); transition-duration: 0.18s; }\n.card.accent { --card-c: var(--accent); --card-halo: rgba(74,158,255,0.18);  --card-spot: rgba(140,180,255,0.10); }\n.card.purple { --card-c: var(--purple); --card-halo: rgba(167,139,250,0.18); --card-spot: rgba(196,181,253,0.10); }\n.card.gold   { --card-c: var(--gold);   --card-halo: rgba(212,175,55,0.16);  --card-spot: rgba(232,208,120,0.09); }\n.card.green  { --card-c: var(--green);  --card-halo: rgba(63,185,80,0.16);   --card-spot: rgba(134,239,172,0.08); }\n.card.cyan   { --card-c: var(--cyan);   --card-halo: rgba(34,211,238,0.16);  --card-spot: rgba(103,232,249,0.09); }\n.card.red    { --card-c: var(--red);    --card-halo: rgba(248,81,73,0.16);   --card-spot: rgba(252,165,165,0.08); }\n.card.silver { --card-c: var(--silver); --card-halo: rgba(176,190,197,0.14); --card-spot: rgba(207,216,220,0.08); }\n\n/* ── 4 · CALLOUT — bloco de destaque com kicker + corpo ───────────── */\n.callout {\n  position: relative; border-radius: 14px; padding: 20px 26px;\n  border: 1px solid var(--co-c, var(--accent));\n  background: linear-gradient(135deg, var(--co-bg1, rgba(74,158,255,0.12)), var(--co-bg2, rgba(74,158,255,0.03)));\n  box-shadow: 0 8px 32px var(--co-glow, rgba(74,158,255,0.12)), inset 0 1px 0 rgba(255,255,255,0.06);\n}\n.callout::before {\n  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;\n  background: linear-gradient(90deg, transparent, var(--co-c, var(--accent)), transparent);\n}\n.callout .co-kicker {\n  font-family: var(--font-mono); font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase;\n  font-weight: 700; margin-bottom: 6px; color: var(--co-c, var(--accent));\n}\n.callout .co-body { font-family: var(--font-editorial); font-size: clamp(15px, 1.7vw, 19px); color: var(--text); line-height: 1.45; }\n.callout .co-body b { color: var(--co-c, var(--accent)); font-weight: 600; }\n.callout.accent { --co-c: var(--accent); --co-bg1: rgba(74,158,255,0.12); --co-bg2: rgba(74,158,255,0.03); --co-glow: rgba(74,158,255,0.12); }\n.callout.red    { --co-c: var(--red);    --co-bg1: rgba(248,81,73,0.16);  --co-bg2: rgba(248,81,73,0.04);  --co-glow: rgba(248,81,73,0.14); }\n.callout.gold   { --co-c: var(--gold);   --co-bg1: rgba(212,175,55,0.16); --co-bg2: rgba(212,175,55,0.04); --co-glow: rgba(212,175,55,0.14); }\n.callout.green  { --co-c: var(--green);  --co-bg1: rgba(63,185,80,0.12);  --co-bg2: rgba(63,185,80,0.03);  --co-glow: rgba(63,185,80,0.10); }\n\n/* ── 5 · STAT-CELL — métrica: número serif gigante + label + fonte ──\n   SEMPRE inclua .sc-src com denominador/fonte do número.            */\n.stat-cell {\n  position: relative; overflow: hidden; text-align: center;\n  padding: 24px 16px; border: 1px solid var(--border); border-radius: 14px; background: var(--surface);\n  transition: transform 0.5s var(--spring), box-shadow 0.5s var(--spring);\n  --sc-c: var(--accent); --sc-halo: rgba(74,158,255,0.18);\n}\n.stat-cell:hover { transform: translateY(-4px) scale(1.006); box-shadow: 0 12px 30px rgba(0,0,0,0.28), 0 0 34px -10px var(--sc-halo); }\n.stat-cell::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--sc-c); opacity: 0.9; }\n.stat-cell::after {\n  content: ''; position: absolute; top: -50px; right: -50px; width: 150px; height: 150px;\n  background: radial-gradient(circle, var(--sc-halo), transparent 70%); pointer-events: none;\n}\n.stat-cell > * { position: relative; z-index: 1; }\n.stat-cell .sc-num { font-family: var(--font-display); font-size: clamp(48px, 6vw, 82px); line-height: 0.95; color: var(--text); }\n.stat-cell .sc-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-dim); margin-top: 8px; line-height: 1.4; }\n.stat-cell .sc-src { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.5px; color: var(--text-dim); opacity: 0.65; margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--border); }\n.stat-cell.sc-accent { --sc-c: var(--accent); --sc-halo: rgba(74,158,255,0.18);  border-color: var(--accent-dim); }\n.stat-cell.sc-gold   { --sc-c: var(--gold);   --sc-halo: rgba(212,175,55,0.16);  border-color: rgba(212,175,55,0.18); }\n.stat-cell.sc-purple { --sc-c: var(--purple); --sc-halo: rgba(167,139,250,0.16); border-color: rgba(167,139,250,0.18); }\n.stat-cell.sc-green  { --sc-c: var(--green);  --sc-halo: rgba(63,185,80,0.16);   border-color: rgba(63,185,80,0.18); }\n.stat-cell.sc-red    { --sc-c: var(--red);    --sc-halo: rgba(248,81,73,0.16);   border-color: rgba(248,81,73,0.18); }\n.stat-cell.sc-cyan   { --sc-c: var(--cyan);   --sc-halo: rgba(34,211,238,0.16);  border-color: rgba(34,211,238,0.18); }\n\n/* ── 6 · GRIDS DE COMPARAÇÃO ──────────────────────────────────────── */\n.two-col   { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 1.8vw, 24px); }\n.three-col { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(14px, 1.6vw, 20px); }\n@media (max-width: 900px) { .two-col, .three-col { grid-template-columns: 1fr; } }\n\n/* ── 7 · SECTION-RULE — régua com texto mono no meio ──────────────── */\n.section-rule {\n  display: flex; align-items: center; gap: 14px; margin: 14px 0;\n  color: var(--text-dim); font-family: var(--font-mono); font-size: 10px;\n  letter-spacing: 2.5px; text-transform: uppercase;\n}\n.section-rule::before, .section-rule::after {\n  content: ''; flex: 1; height: 1px;\n  background: linear-gradient(90deg, transparent, var(--border-bright), transparent);\n}\n\n/* ── 8 · CODE-BLOCK — syntax spans + badge de linguagem ───────────── */\n.code-block {\n  position: relative; overflow: hidden; background: var(--code-bg);\n  border: 1px solid var(--border); border-radius: 12px; padding: 22px 24px;\n  color: var(--code-text); white-space: pre-wrap; tab-size: 2;\n  font-family: var(--font-mono); font-feature-settings: 'calt' 1, 'liga' 1;\n  letter-spacing: 0.01em; font-size: clamp(12px, 1.15vw, 14px); line-height: 1.65;\n}\n.code-block::before {\n  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;\n  background: linear-gradient(90deg, transparent, var(--accent) 50%, transparent); opacity: 0.4;\n}\n.code-block[data-lang]::after {\n  content: attr(data-lang); position: absolute; top: 10px; right: 12px;\n  font-family: var(--font-mono); font-size: 9px; font-weight: 800; letter-spacing: 2.5px;\n  text-transform: uppercase; color: #000; background: var(--accent); padding: 4px 11px; border-radius: 5px;\n  box-shadow: 0 4px 14px rgba(74,158,255,0.35), 0 0 0 1px rgba(74,158,255,0.6), inset 0 1px 0 rgba(255,255,255,0.3);\n}\n.code-block .k { color: #7dd3fc; font-weight: 600; }                  /* keyword */\n.code-block .s { color: #86efac; }                                    /* string */\n.code-block .c { color: #94a3b8; font-style: italic; opacity: 0.85; } /* comentário */\n.code-block .n { color: #fcd34d; }                                    /* número */\n.code-block .r { color: #fda4a4; }                                    /* operador */\n.code-block .h { color: #c4b5fd; }                                    /* chamada / nome */\n\n/* ── 10 · LOGO-TILE — strip de marcas: cinza que ganha cor no hover ─ */\n.logo-tile {\n  width: clamp(52px, 4.6vw, 64px); height: clamp(52px, 4.6vw, 64px); border-radius: 15px;\n  background: radial-gradient(ellipse at 50% 35%, rgba(255,255,255,0.05), var(--code-bg) 78%);\n  border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);\n  transition: transform 0.45s var(--spring), border-color 0.45s var(--spring), box-shadow 0.45s var(--spring);\n}\n.logo-tile img {\n  width: 60%; height: 60%; object-fit: contain;\n  filter: grayscale(1) opacity(0.45);\n  transition: filter 0.45s var(--spring), transform 0.45s var(--spring);\n}\n.logo-tile:hover {\n  transform: translateY(-5px) scale(1.07); border-color: var(--border-bright);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 12px 26px rgba(0,0,0,0.45), 0 0 24px rgba(120,160,220,0.10);\n}\n.logo-tile:hover img { filter: none; transform: scale(1.04); }\n\n/* ── 11 · EFEITOS DE DIAGRAMA — handoff SDD, setas de fluxo, anéis ─ */\n.sdd-glow { position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0.1; animation: sdd-hand 5.4s var(--drift) infinite; }\n@keyframes sdd-hand { 0%, 100% { opacity: 0.08; } 22% { opacity: 0.85; } 48% { opacity: 0.08; } }\n.flow-arrow { display: inline-block; animation: arrow-flow 2.2s ease-in-out infinite; }\n@keyframes arrow-flow { 0%, 100% { opacity: 0.35; transform: translateX(0); } 50% { opacity: 1; transform: translateX(5px); } }\n.ring-spin { transform-box: fill-box; transform-origin: center; animation: ring-spin 60s linear infinite; }\n@keyframes ring-spin { to { transform: rotate(360deg); } }\n\n/* ── pirâmide interativa: hover/foco nos degraus + pulse da dica ── */\n@keyframes pyr-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.72); } }\n@keyframes pyr-hint-glow { 0%, 100% { box-shadow: 0 0 0 1px rgba(212,175,55,0.28), 0 4px 16px rgba(212,175,55,0.08); } 50% { box-shadow: 0 0 0 1px rgba(212,175,55,0.5), 0 6px 22px rgba(212,175,55,0.18); } }\n.pyr-step:hover, .pyr-step:focus-visible { transform: translateX(6px); border-color: var(--border-bright); box-shadow: 0 8px 30px rgba(0,0,0,0.35); outline: none; }\n.pyr-step.is-active { transform: translateX(6px); box-shadow: 0 10px 34px rgba(0,0,0,0.4); }\n.pyr-step:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }\n\n/* dica \"clique num degrau\" — pílula viva */\n.pyr-hint {\n  display: inline-flex; align-items: center; gap: 9px; align-self: flex-start;\n  font-family: var(--font-mono); font-size: clamp(9.5px,0.95vw,11.5px); font-weight: 600;\n  letter-spacing: 1.6px; text-transform: uppercase; color: var(--gold);\n  padding: 8px 15px 8px 12px; border-radius: 999px;\n  background: linear-gradient(90deg, rgba(212,175,55,0.12), rgba(212,175,55,0.03));\n  border: 1px solid rgba(212,175,55,0.3);\n  animation: pyr-hint-glow 2.8s ease-in-out infinite;\n}\n.pyr-hint .pyr-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 12px var(--gold); animation: pyr-pulse 2.4s ease-in-out infinite; flex-shrink: 0; }\n\n/* botão \"voltar à visão geral\" — pílula ghost dourada, preenche no hover */\n.pyr-back {\n  align-self: flex-start; margin-top: auto;\n  display: inline-flex; align-items: center; gap: 8px;\n  font-family: var(--font-mono); font-size: clamp(9.5px,0.95vw,12px); font-weight: 700;\n  letter-spacing: 1.6px; text-transform: uppercase; color: var(--gold);\n  background: rgba(212,175,55,0.06); border: 1px solid rgba(212,175,55,0.45);\n  border-radius: 999px; padding: 9px 17px; cursor: pointer;\n  transition: color .2s ease, background .2s ease, box-shadow .2s ease, transform .2s ease;\n}\n.pyr-back .pyr-arrow { display: inline-block; transition: transform .2s ease; }\n.pyr-back:hover, .pyr-back:focus-visible {\n  color: #000; background: var(--gold);\n  box-shadow: 0 6px 22px rgba(212,175,55,0.4), inset 0 1px 0 rgba(255,255,255,0.3);\n  outline: none; transform: translateY(-1px);\n}\n.pyr-back:hover .pyr-arrow, .pyr-back:focus-visible .pyr-arrow { transform: translateX(-3px); }\n.pyr-back:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }\n\n@media (prefers-reduced-motion: reduce) {\n  .pyr-step { transition: none !important; }\n  .pyr-step:hover, .pyr-step:focus-visible, .pyr-step.is-active { transform: none; }\n  #pyr-default, #pyr-detail { transition: none !important; }\n  .pyr-hint, .pyr-hint .pyr-dot { animation: none !important; }\n  .pyr-back { transition: none !important; }\n  .pyr-back:hover, .pyr-back:focus-visible { transform: none; }\n  .pyr-back:hover .pyr-arrow, .pyr-back:focus-visible .pyr-arrow { transform: none; }\n}\n\n/* ── 12 · ESCADA DE DISCIPLINAS (ref ep-1) ────────────────────────── */\n.ladder { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1.2fr; gap: clamp(8px,1vw,16px); align-items: end; width: 100%; max-width: 1700px; margin: clamp(10px,1.6vh,20px) auto 0; }\n.rung { border: 1px solid var(--border-bright); border-radius: 16px; padding: clamp(14px,1.8vh,24px) clamp(14px,1.3vw,24px); background: var(--surface); position: relative; border-top: 3px solid var(--rg-c, var(--silver)); display: flex; flex-direction: column; transition: transform 0.5s var(--spring), box-shadow 0.5s var(--spring); }\n.rung:hover { transform: translateY(-5px); box-shadow: 0 14px 34px rgba(0,0,0,0.3); }\n.rung .rg-num { align-self: flex-start; font-family: var(--font-mono); font-size: clamp(9px,0.85vw,11px); font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: #000; background: var(--rg-c, var(--silver)); padding: 5px 12px; border-radius: 5px; margin-bottom: 14px; box-shadow: 0 5px 18px var(--rg-glow, rgba(176,190,197,0.35)), 0 0 0 1px var(--rg-c, var(--silver)), inset 0 1px 0 rgba(255,255,255,0.3); }\n.rung .rg-num::before { content: '\\25C6'; margin-right: 7px; opacity: 0.7; }\n.rung .rg-name { font-family: var(--font-display); font-size: clamp(23px,2.4vw,36px); color: var(--text); line-height: 1; margin-bottom: 10px; }\n.rung .rg-what { font-family: var(--font-editorial); font-size: clamp(13px,1.2vw,16px); color: var(--text-dim); line-height: 1.5; }\n.rung .rg-verdict { font-family: var(--font-display); font-style: italic; font-size: clamp(15px,1.5vw,21px); letter-spacing: 0.2px; white-space: nowrap; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--border); color: var(--rg-c, var(--silver)); }\n.rung.r1 { --rg-c: var(--accent); --rg-glow: rgba(74,158,255,0.4); min-height: clamp(170px,23vh,240px); background: linear-gradient(180deg, rgba(74,158,255,0.06), rgba(74,158,255,0.01)); border-color: rgba(74,158,255,0.24); }\n.rung.r2 { --rg-c: var(--cyan); --rg-glow: rgba(34,211,238,0.4); min-height: clamp(215px,29vh,300px); background: linear-gradient(180deg, rgba(34,211,238,0.06), rgba(34,211,238,0.01)); border-color: rgba(34,211,238,0.24); }\n.rung.r3 { --rg-c: var(--gold); --rg-glow: rgba(212,175,55,0.4); min-height: clamp(260px,35vh,360px); background: linear-gradient(180deg, rgba(212,175,55,0.08), rgba(212,175,55,0.01)); border-color: rgba(212,175,55,0.30); }\n.rung.r4 { --rg-c: var(--green); --rg-glow: rgba(63,185,80,0.4); min-height: clamp(305px,42vh,430px); background: linear-gradient(180deg, rgba(63,185,80,0.09), rgba(63,185,80,0.01)); border-color: rgba(63,185,80,0.34); box-shadow: 0 10px 40px rgba(63,185,80,0.10); }\n.lad-arrow { display: flex; align-items: center; justify-content: center; align-self: center; font-family: var(--font-display); font-size: clamp(20px,2.3vw,34px); color: var(--text-dim); opacity: 0.6; padding-bottom: clamp(26px,7vh,80px); }\n@media (max-width: 860px) { .ladder { grid-template-columns: 1fr; align-items: stretch; } .lad-arrow { display: none; } .rung { min-height: 0 !important; } }\n\n/* ── 13 · ANÉIS CONCÊNTRICOS SVG — respiração e fluxo ─────────────── */\n.slide.is-active .hr-ring { transform-box: fill-box; transform-origin: center; animation: ring-breathe 9s ease-in-out infinite; }\n.slide.is-active .hr-ring--2 { animation-delay: 1.2s; }\n.slide.is-active .hr-ring--3 { animation-delay: 2.4s; }\n.slide.is-active .hr-ring--4 { animation-delay: 3.6s; }\n.slide.is-active .hr-ring--5 { animation-delay: 4.8s; }\n.slide.is-active .hr-ring--6 { animation-delay: 6s; }\n.slide.is-active .hr-core-c { transform-box: fill-box; transform-origin: center; animation: core-pulse 4s ease-in-out infinite; }\n.slide.is-active .hr-flow { stroke-dasharray: 12 16; animation: dash-flow 1.5s linear infinite; }\n@keyframes ring-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.022); } }\n@keyframes core-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.045); } }\n@keyframes dash-flow { to { stroke-dashoffset: -28; } }\n\n/* ── 14 · DARK FACTORY CARD — a fábrica acende no escuro ──────────── */\n.df-card { position: relative; overflow: hidden; transition: transform 0.6s var(--spring), box-shadow 0.6s var(--spring), border-color 0.6s var(--spring), background 0.6s var(--spring); }\n.df-card::before { content: ''; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 30%, rgba(212,175,55,0.35) 48%, rgba(255,255,255,0.3) 50%, rgba(212,175,55,0.35) 52%, transparent 70%); transform: translateX(-130%); transition: transform 0.9s var(--ease-out-expo); pointer-events: none; }\n.df-card:hover { transform: translateY(-9px) scale(1.06); border-color: var(--gold) !important; background: #050506 !important; box-shadow: 0 22px 54px -12px rgba(0,0,0,0.75), 0 0 64px -6px rgba(212,175,55,0.55) !important; }\n.df-card:hover::before { transform: translateX(130%); }\n.df-card .df-glyph { position: absolute; left: 10px; right: 10px; bottom: 14px; text-align: center; font-family: var(--font-display); font-style: italic; font-size: clamp(15px,1.4vw,21px); line-height: 1.25; color: var(--gold); opacity: 0; transform: translateY(10px) scale(0.7); transition: opacity 0.5s var(--spring) 0.15s, transform 0.5s var(--spring) 0.15s; pointer-events: none; text-shadow: 0 0 16px rgba(212,175,55,0.7); }\n.df-card:hover .df-glyph { opacity: 1; transform: translateY(0) scale(1); }\n.df-card .df-fade { transition: opacity 0.45s var(--spring), filter 0.45s var(--spring); }\n.df-card:hover .df-fade { opacity: 0.1; filter: blur(3px); }\n\n/* ── 9 · MOTION / REVEAL — fade-up + blur escalonado ──────────────\n   Uso: envolva os filhos num container .reveal; o JS liga .in\n   quando a slide fica ativa (threshold 0.5, root .deck).           */\nbody.anim-ready .reveal > * {\n  opacity: 0; transform: translateY(28px); filter: blur(6px);\n  transition: opacity 0.9s var(--ease-out-expo), transform 0.9s var(--ease-out-expo), filter 0.75s var(--ease-out-expo);\n  transition-delay: 0ms;\n}\nbody.anim-ready .reveal.in > * { opacity: 1; transform: translateY(0); filter: blur(0); }\nbody.anim-ready .reveal.in > *:nth-child(1) { transition-delay: 60ms; }\nbody.anim-ready .reveal.in > *:nth-child(2) { transition-delay: 140ms; }\nbody.anim-ready .reveal.in > *:nth-child(3) { transition-delay: 220ms; }\nbody.anim-ready .reveal.in > *:nth-child(4) { transition-delay: 300ms; }\nbody.anim-ready .reveal.in > *:nth-child(5) { transition-delay: 380ms; }\nbody.anim-ready .reveal.in > *:nth-child(6) { transition-delay: 460ms; }\nbody.anim-ready .reveal.in > *:nth-child(7) { transition-delay: 540ms; }\nbody.anim-ready .reveal.in > *:nth-child(n+8) { transition-delay: 620ms; }\n\n/* divisores de ato — subida mais grandiosa, com leve escala */\nbody.anim-ready .slide--silent .reveal > *, body.anim-ready .slide--title .reveal > * {\n  transform: translateY(40px) scale(0.985); filter: blur(8px); transition-duration: 1.05s;\n}\nbody.anim-ready .slide--silent .reveal.in > *, body.anim-ready .slide--title .reveal.in > * {\n  transform: translateY(0) scale(1); filter: blur(0);\n}\n/* numeral de ato flutua depois de revelado */\n.slide--silent.is-active .slide__display--act { animation: numeral-float 7s var(--drift) 1.8s infinite; }\n@keyframes numeral-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }\n\n/* shimmer vivo no gradiente do título quando ativo */\n.slide--title.is-active .slide__display.gradient-text,\n.slide--title.is-active .slide__display .gradient-text {\n  background-size: 220% auto; animation: title-shimmer 7s var(--drift) infinite;\n}\n@keyframes title-shimmer { 0%, 100% { background-position: 0% center; } 50% { background-position: 100% center; } }\n\n/* ── KICKER — eyebrow refinado (pill com traço + ponto pulsante) ── */\n.kicker {\n  display: inline-flex; align-items: center; gap: 12px; margin-bottom: clamp(14px,2vh,20px);\n  font-family: var(--font-mono); font-size: clamp(10.5px,1.05vw,13px); font-weight: 600;\n  letter-spacing: 2.5px; text-transform: uppercase; color: var(--kc-c, var(--accent));\n  padding: 8px 16px 8px 14px; border: 1px solid var(--kc-line, rgba(74,158,255,0.22));\n  border-radius: 999px; background: linear-gradient(180deg, rgba(255,255,255,0.03), transparent 70%), var(--kc-bg, rgba(74,158,255,0.05));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);\n}\n.kicker::before {\n  content: ''; width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;\n  background: var(--kc-c, var(--accent)); box-shadow: 0 0 10px var(--kc-c, var(--accent));\n  animation: counter-pulse 2.6s var(--drift) infinite;\n}\n.kicker.red    { --kc-c: var(--red);    --kc-line: rgba(248,81,73,0.30);  --kc-bg: rgba(248,81,73,0.06); }\n.kicker.gold   { --kc-c: var(--gold);   --kc-line: rgba(212,175,55,0.30); --kc-bg: rgba(212,175,55,0.06); }\n.kicker.green  { --kc-c: var(--green);  --kc-line: rgba(63,185,80,0.30);  --kc-bg: rgba(63,185,80,0.06); }\n.kicker.purple { --kc-c: var(--purple); --kc-line: rgba(167,139,250,0.30);--kc-bg: rgba(167,139,250,0.06); }\n.kicker.cyan   { --kc-c: var(--cyan);   --kc-line: rgba(34,211,238,0.30); --kc-bg: rgba(34,211,238,0.06); }\n\n/* ── AUDIENCE-CELLS (slide \"quem está nesta sala\") — stats grandes ── */\n.audience-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(18px,1.8vw,28px); align-items: stretch; }\n.aud-cell {\n  position: relative; overflow: hidden; text-align: center;\n  display: flex; flex-direction: column; justify-content: center; align-items: center; gap: clamp(12px,1.8vh,20px);\n  padding: clamp(34px,5.2vh,60px) clamp(22px,2vw,36px);\n  border: 1px solid var(--ac-line, var(--border-bright)); border-radius: 20px;\n  background: linear-gradient(180deg, var(--ac-fill, rgba(74,158,255,0.08)), var(--surface) 65%);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 26px 54px -30px rgba(0,0,0,0.6);\n  transition: transform 0.55s var(--spring), box-shadow 0.55s var(--spring), border-color 0.55s var(--spring);\n  --ac-c: var(--accent); --ac-fill: rgba(74,158,255,0.08); --ac-line: rgba(74,158,255,0.24); --ac-glow: rgba(74,158,255,0.4);\n}\n.aud-cell:hover { transform: translateY(-8px); border-color: var(--ac-c); box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 30px 60px -24px rgba(0,0,0,0.6), 0 0 50px -8px var(--ac-glow); }\n.aud-cell::before { content: ''; position: absolute; top: 0; left: 20%; right: 20%; height: 4px; border-radius: 0 0 4px 4px; background: var(--ac-c); box-shadow: 0 0 16px var(--ac-glow); }\n.aud-cell::after { content: ''; position: absolute; top: -70px; right: -70px; width: 220px; height: 220px; background: radial-gradient(circle, var(--ac-glow), transparent 68%); opacity: 0.5; pointer-events: none; }\n.aud-cell > * { position: relative; z-index: 1; }\n.aud-num { font-family: var(--font-display); font-size: clamp(64px,9vw,128px); line-height: 0.88; color: var(--text); letter-spacing: -2px; }\n.aud-label { font-family: var(--font-editorial); font-size: clamp(15px,1.5vw,20px); color: var(--text-dim); line-height: 1.4; max-width: 22ch; }\n.aud-label b { color: var(--text); font-weight: 600; }\n.aud-src { font-family: var(--font-mono); font-size: clamp(9.5px,0.9vw,11.5px); letter-spacing: 0.5px; color: var(--text-dim); opacity: 0.7; padding-top: clamp(10px,1.4vh,14px); border-top: 1px solid var(--border); width: 100%; }\n.aud-cell.ac-accent { --ac-c: var(--accent); --ac-fill: rgba(74,158,255,0.09);  --ac-line: rgba(74,158,255,0.26); --ac-glow: rgba(74,158,255,0.4); }\n.aud-cell.ac-purple { --ac-c: var(--purple); --ac-fill: rgba(167,139,250,0.09); --ac-line: rgba(167,139,250,0.26); --ac-glow: rgba(167,139,250,0.4); }\n.aud-cell.ac-gold   { --ac-c: var(--gold);   --ac-fill: rgba(212,175,55,0.09);  --ac-line: rgba(212,175,55,0.26); --ac-glow: rgba(212,175,55,0.4); }\n.aud-flow { font-family: var(--font-mono); font-size: clamp(11px,1.15vw,14px); letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-dim); text-align: center; margin-top: clamp(24px,4vh,44px); }\n.aud-flow span { color: var(--text); }\n.aud-flow span:nth-child(1) { color: var(--accent); }\n.aud-flow span:nth-child(2) { color: var(--cyan); }\n.aud-flow span:nth-child(3) { color: var(--purple); }\n.aud-flow span:nth-child(4) { color: var(--green); }\n@media (max-width: 860px) { .audience-grid { grid-template-columns: 1fr; } }\n\n/* ── UNIT-CARDS (slide \"De ticket para intenção\") — cards maiores com código-prova ── */\n.unit-grid {\n  display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(12px, 1.1vw, 18px);\n  margin-top: clamp(20px, 3vh, 32px); align-items: stretch;\n}\n.unit-card {\n  position: relative; display: flex; flex-direction: column; overflow: hidden;\n  border: 1px solid var(--border-bright); border-radius: 16px;\n  background: linear-gradient(180deg, var(--uc-fill, rgba(74,158,255,0.07)), var(--surface) 60%);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 20px 44px -26px rgba(0,0,0,0.6);\n  border-top: 3px solid var(--uc-c, var(--accent));\n  min-height: clamp(300px, 44vh, 400px);\n  transition: transform 0.5s var(--spring), box-shadow 0.5s var(--spring), border-color 0.5s var(--spring);\n  --uc-c: var(--accent); --uc-fill: rgba(74,158,255,0.07); --uc-glow: rgba(74,158,255,0.4);\n}\n.unit-card:hover { transform: translateY(-6px); border-color: var(--uc-c); box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 26px 54px -22px rgba(0,0,0,0.6), 0 0 40px -8px var(--uc-glow); }\n/* corner brackets */\n.uc-brk { position: absolute; width: 16px; height: 16px; pointer-events: none; }\n.uc-brk-tr { top: 11px; right: 11px; border-top: 1.5px solid var(--uc-c); border-right: 1.5px solid var(--uc-c); opacity: 0.8; }\n.uc-brk-bl { bottom: 11px; left: 11px; border-bottom: 1.5px solid var(--uc-c); border-left: 1.5px solid var(--uc-c); opacity: 0.35; }\n/* header: número + swap antes→agora */\n.uc-head { padding: clamp(15px,2vh,20px) clamp(15px,1.2vw,19px) 12px; }\n.uc-n { display: inline-block; font-family: var(--font-mono); font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: #000; background: var(--uc-c); padding: 4px 10px; border-radius: 5px; box-shadow: 0 4px 14px var(--uc-glow), inset 0 1px 0 rgba(255,255,255,0.3); }\n.uc-swap { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; margin-top: 12px; }\n.uc-swap s { font-family: var(--font-editorial); font-size: clamp(13px,1.15vw,16px); color: var(--text-dim); text-decoration-line: line-through; text-decoration-color: rgba(248,81,73,0.7); text-decoration-thickness: 2px; }\n.uc-swap .uc-arrow { font-family: var(--font-mono); font-size: 13px; color: var(--uc-c); opacity: 0.8; }\n.uc-swap b { font-family: var(--font-display); font-size: clamp(20px,1.9vw,27px); font-weight: 400; color: var(--text); line-height: 1.02; letter-spacing: -0.3px; }\n/* code-proof block (estilo code-2.png) */\n.uc-code {\n  display: block;\n  position: relative; margin: 4px clamp(11px,1vw,15px) clamp(13px,1.6vh,17px); flex: 1;\n  background: var(--code-bg); border: 1px solid var(--border); border-radius: 11px;\n  padding: clamp(22px,3.4vh,40px) 15px; overflow: hidden; white-space: pre; tab-size: 2;\n  font-family: var(--font-mono); font-feature-settings: 'calt' 1, 'liga' 1;\n  font-size: clamp(10px, 0.84vw, 12px); line-height: 1.9; color: var(--code-text);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);\n}\n.uc-code::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--uc-c) 50%, transparent); opacity: 0.4; }\n.uc-code[data-lang]::after { content: attr(data-lang); position: absolute; top: 8px; right: 9px; font-family: var(--font-mono); font-size: 8px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #000; background: var(--uc-c); padding: 3px 8px; border-radius: 4px; box-shadow: 0 3px 10px var(--uc-glow), inset 0 1px 0 rgba(255,255,255,0.3); }\n.uc-code .k { color: #7dd3fc; font-weight: 600; }\n.uc-code .s { color: #86efac; }\n.uc-code .c { color: #94a3b8; font-style: italic; opacity: 0.85; }\n.uc-code .n { color: #fcd34d; }\n.uc-code .r { color: #fda4a4; }\n.uc-code .h { color: #c4b5fd; }\n.uc-code .g { color: #86efac; font-weight: 600; }\n/* variantes de cor por card */\n.unit-card.ua-accent { --uc-c: var(--accent); --uc-fill: rgba(74,158,255,0.08);  --uc-glow: rgba(74,158,255,0.4); }\n.unit-card.ua-cyan   { --uc-c: var(--cyan);   --uc-fill: rgba(34,211,238,0.08);  --uc-glow: rgba(34,211,238,0.4); }\n.unit-card.ua-purple { --uc-c: var(--purple); --uc-fill: rgba(167,139,250,0.08); --uc-glow: rgba(167,139,250,0.4); }\n.unit-card.ua-green  { --uc-c: var(--green);  --uc-fill: rgba(63,185,80,0.08);   --uc-glow: rgba(63,185,80,0.4); }\n.unit-card.ua-gold   { --uc-c: var(--gold);   --uc-fill: rgba(212,175,55,0.08);  --uc-glow: rgba(212,175,55,0.4); }\n@media (max-width: 1200px) { .unit-grid { grid-template-columns: repeat(2, 1fr); } }\n@media (max-width: 640px)  { .unit-grid { grid-template-columns: 1fr; } }\n\n/* ── SLIDE-HANDS — pôster tipográfico sobre imagem cinematográfica (máquina + humano) ── */\n.slide--hands { justify-content: center; align-items: flex-start; text-align: left; }\n.hands-bg {\n  position: absolute; inset: 0; z-index: 0; pointer-events: none;\n  background-size: cover; background-position: center right;\n  transform: scale(1.06); transform-origin: center;\n  transition: transform 8s ease-out;\n}\n.slide--hands.is-active .hands-bg { transform: scale(1.12); } /* ken-burns lento */\n/* wash de legibilidade: escurece a esquerda (texto) e o rodapé, deixa a imagem respirar à direita */\n.hands-wash {\n  position: absolute; inset: 0; z-index: 1; pointer-events: none;\n  background:\n    linear-gradient(90deg, rgba(8,8,10,0.95) 0%, rgba(8,8,10,0.82) 34%, rgba(8,8,10,0.34) 62%, rgba(8,8,10,0.12) 100%),\n    linear-gradient(180deg, rgba(8,8,10,0.5) 0%, transparent 26%, transparent 62%, rgba(8,8,10,0.6) 100%);\n}\n.slide--hands .slide__display, .slide--hands .slide__heading { position: relative; }\n@media (prefers-reduced-motion: reduce) { .hands-bg { transform: none !important; } }\n\n/* ── GUARD-CARDS (slide 17 · \"o que a disciplina protege\") — redução riscada → verdade ── */\n.guard-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(14px,1.4vw,22px); max-width: 1360px; width: 100%; margin-top: clamp(16px,2.6vh,28px); text-align: left; }\n.guard-card {\n  position: relative; overflow: hidden; border-radius: 16px;\n  border: 1px solid var(--border-bright); border-top: 3px solid var(--green);\n  background: linear-gradient(180deg, rgba(63,185,80,0.06), var(--surface) 58%);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 20px 44px -26px rgba(0,0,0,0.6);\n  padding: clamp(18px,2.4vh,26px) clamp(18px,1.5vw,26px);\n  transition: transform 0.5s var(--spring), box-shadow 0.5s var(--spring), border-color 0.5s var(--spring);\n}\n.guard-card:hover { transform: translateY(-6px); border-color: var(--green); box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 26px 54px -22px rgba(0,0,0,0.6), 0 0 42px -8px rgba(63,185,80,0.35); }\n.guard-card::after { content: ''; position: absolute; top: -60px; right: -60px; width: 190px; height: 190px; background: radial-gradient(circle, rgba(63,185,80,0.14), transparent 68%); pointer-events: none; }\n.guard-card > * { position: relative; z-index: 1; }\n.guard-brk { position: absolute; width: 15px; height: 15px; pointer-events: none; }\n.gb-tr { top: 11px; right: 11px; border-top: 1.5px solid var(--green); border-right: 1.5px solid var(--green); opacity: 0.7; }\n.gb-bl { bottom: 11px; left: 11px; border-bottom: 1.5px solid var(--green); border-left: 1.5px solid var(--green); opacity: 0.3; }\n.guard-top { display: flex; align-items: center; gap: 10px; margin-bottom: clamp(12px,1.8vh,16px); }\n.guard-n { font-family: var(--font-mono); font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: #000; background: var(--green); padding: 4px 10px; border-radius: 5px; box-shadow: 0 4px 14px rgba(63,185,80,0.4), inset 0 1px 0 rgba(255,255,255,0.3); }\n.guard-tag { font-family: var(--font-display); font-style: italic; font-size: clamp(16px,1.55vw,22px); letter-spacing: 0.01em; text-transform: none; color: var(--green); opacity: 0.92; }\n.guard-neg { font-family: var(--font-editorial); font-style: italic; font-size: clamp(14px,1.35vw,18px); line-height: 1.35; margin-bottom: 11px; }\n.guard-neg s { color: var(--text-dim); text-decoration-line: line-through; text-decoration-color: rgba(248,81,73,0.8); text-decoration-thickness: 2px; }\n.guard-pos { font-family: var(--font-editorial); font-size: clamp(14.5px,1.4vw,18.5px); line-height: 1.42; color: var(--text); }\n.guard-pos b { color: var(--green); font-weight: 600; }\n.guard-pos i { color: var(--text-dim); }\n.guard-pos .gp-2 { display: block; margin-top: 5px; font-size: 0.92em; color: var(--text-dim); font-style: italic; }\n@media (max-width: 860px) { .guard-grid { grid-template-columns: 1fr; } }\n\n/* ── TODO-TOKEN — dado pendente, impossível de apresentar sem ver ── */\n.todo {\n  color: var(--gold); -webkit-text-fill-color: var(--gold);\n  background: rgba(212,175,55,0.10); border-radius: 5px;\n  padding: 0 0.08em; letter-spacing: 0.04em;\n  text-shadow: 0 0 26px rgba(212,175,55,0.45);\n  box-shadow: inset 0 0 0 1px rgba(212,175,55,0.35);\n}\n\n/* ── REDUCED MOTION — tudo resolve no estado final, sem deriva ────── */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { animation: none !important; transition: none !important; }\n  .deck { scroll-behavior: auto; }\n  body.anim-ready .reveal > * { opacity: 1; transform: none; filter: none; }\n}\n\n/* ── checklist acionável (S32) ── */\n.ck{display:flex;align-items:baseline;gap:11px;padding:clamp(9px,1.5vh,14px) 0;border-bottom:1px solid var(--border);cursor:pointer;-webkit-user-select:none;user-select:none;}\n.ck:last-of-type{border-bottom:none;}\n.ck-box{width:16px;height:16px;border-radius:5px;border:1.5px solid rgba(var(--ck-rgb,212,175,55),0.6);background:rgba(var(--ck-rgb,212,175,55),0.08);flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;font-size:10.5px;font-weight:800;color:transparent;transform:translateY(2.5px);transition:background 0.35s var(--ease-out-expo),color 0.35s var(--ease-out-expo),box-shadow 0.35s var(--ease-out-expo);}\n.ck-box::after{content:'✓';}\n.ck:hover .ck-box{border-color:var(--ck-c,var(--gold));box-shadow:0 0 10px rgba(var(--ck-rgb,212,175,55),0.3);}\n.ck.done .ck-box{background:var(--ck-c,var(--gold));border-color:var(--ck-c,var(--gold));color:#000;box-shadow:0 0 14px rgba(var(--ck-rgb,212,175,55),0.55);}\n.ck-t{font-family:var(--font-editorial);font-style:italic;font-size:clamp(12px,1.1vw,15.5px);color:var(--text);line-height:1.42;transition:color 0.35s,text-decoration-color 0.35s;text-decoration:line-through;text-decoration-color:transparent;}\n.ck.done .ck-t{color:var(--text-dim);text-decoration-color:rgba(var(--ck-rgb,212,175,55),0.55);}\n\n/* ── noite-card (S39): pulso em cascata + hover com número-fantasma ── */\n.nv-card{position:relative;overflow:hidden;transition:transform .5s var(--spring),box-shadow .5s var(--spring),border-color .5s var(--spring);}\n.nv-card:hover{transform:translateY(-9px) scale(1.02);border-color:rgba(167,139,250,0.75) !important;box-shadow:inset 0 1px 0 rgba(255,255,255,0.08),0 24px 60px -20px rgba(0,0,0,0.7),0 0 54px -10px rgba(167,139,250,0.6) !important;}\n.nv-num{position:absolute;right:-4px;bottom:-16px;font-family:var(--font-display);font-style:italic;font-size:clamp(96px,9.5vw,150px);line-height:1;color:transparent;-webkit-text-stroke:1.5px rgba(167,139,250,0);pointer-events:none;transform:translateY(14px);transition:transform .6s var(--spring),-webkit-text-stroke-color .6s ease,color .6s ease;}\n.nv-card:hover .nv-num{color:rgba(167,139,250,0.10);-webkit-text-stroke-color:rgba(167,139,250,0.45);transform:translateY(0);}\n.nv-card .sdd-glow{border-radius:inherit;}\n\n/* ── VERIFY-BAY (S25) — painel de instrumentos: as três perguntas ──\n   Registro visual novo: mostrador, não cartão. Repouso = LED âmbar\n   \"sem sinal\", resposta ruim acesa. Hover/foco = liga: LED verde, a\n   linha PASS acende, a ruim apaga. O mesmo painel volta no Ato 3B\n   preenchido com as respostas reais da fábrica.                     */\n.vq-rail {\n  display:flex; align-items:center; gap:clamp(10px,1.2vw,18px);\n  font-family:var(--font-mono); font-size:clamp(9px,0.88vw,11px); font-weight:600;\n  letter-spacing:2.5px; text-transform:uppercase; color:var(--gold); opacity:0.75;\n  margin-bottom:clamp(10px,1.6vh,16px);\n}\n.vq-rail::after { content:''; flex:1; height:1px; background:linear-gradient(90deg, rgba(212,175,55,0.45), transparent); }\n\n.vq-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(14px,1.5vw,22px); align-items:stretch; }\n@media (max-width:1000px) { .vq-grid { grid-template-columns:1fr; } }\n\n.vq-bay {\n  position:relative; overflow:hidden; display:flex; flex-direction:column;\n  border:1px solid var(--border-bright); border-top:3px solid var(--gold); border-radius:16px;\n  padding:clamp(16px,2.2vh,24px) clamp(15px,1.3vw,22px);\n  background:linear-gradient(180deg, rgba(212,175,55,0.05), var(--surface) 58%);\n  box-shadow:inset 0 1px 0 rgba(255,255,255,0.06), 0 22px 48px -28px rgba(0,0,0,0.65);\n  transition:transform .55s var(--spring), box-shadow .55s var(--spring), border-color .55s var(--spring), background .55s var(--spring);\n}\n.vq-bay::after { /* varredura de mostrador — textura de instrumento */\n  content:''; position:absolute; inset:0; pointer-events:none; opacity:0.5; mix-blend-mode:overlay;\n  background:repeating-linear-gradient(180deg, rgba(255,255,255,0.03) 0 1px, transparent 1px 4px);\n}\n.vq-bay > * { position:relative; z-index:1; }\n.vq-bay:hover, .vq-bay:focus-visible {\n  transform:translateY(-7px); outline:none; border-color:var(--green);\n  background:linear-gradient(180deg, rgba(63,185,80,0.07), #050506 62%);\n  box-shadow:inset 0 1px 0 rgba(255,255,255,0.08), 0 28px 58px -22px rgba(0,0,0,0.72), 0 0 52px -10px rgba(63,185,80,0.45);\n}\n.vq-bay:focus-visible { outline:2px solid var(--green); outline-offset:3px; }\n.vq-brk { position:absolute; width:15px; height:15px; pointer-events:none; z-index:2; transition:border-color .5s var(--spring); }\n.vq-brk-tr { top:11px; right:11px; border-top:1.5px solid var(--gold); border-right:1.5px solid var(--gold); opacity:0.7; }\n.vq-brk-bl { bottom:11px; left:11px; border-bottom:1.5px solid var(--gold); border-left:1.5px solid var(--gold); opacity:0.3; }\n.vq-bay:hover .vq-brk, .vq-bay:focus-visible .vq-brk { border-color:var(--green); }\n\n.vq-top { display:flex; align-items:center; gap:10px; margin-bottom:clamp(12px,1.8vh,18px); }\n.vq-n {\n  font-family:var(--font-mono); font-size:10px; font-weight:800; letter-spacing:1.5px;\n  color:#000; background:var(--gold); padding:4px 10px; border-radius:5px;\n  box-shadow:0 4px 14px rgba(212,175,55,0.4), inset 0 1px 0 rgba(255,255,255,0.3);\n  transition:background .45s var(--spring), box-shadow .45s var(--spring);\n}\n.vq-bay:hover .vq-n, .vq-bay:focus-visible .vq-n { background:var(--green); box-shadow:0 4px 14px rgba(63,185,80,0.45), inset 0 1px 0 rgba(255,255,255,0.3); }\n.vq-led {\n  margin-left:auto; display:inline-flex; align-items:center; gap:7px;\n  font-family:var(--font-mono); font-size:clamp(8.5px,0.8vw,10px); font-weight:700;\n  letter-spacing:1.6px; text-transform:uppercase; color:var(--text-dim);\n  transition:color .45s var(--spring);\n}\n.vq-led::before {\n  content:''; width:8px; height:8px; border-radius:50%; flex-shrink:0;\n  background:rgba(212,175,55,0.35); box-shadow:0 0 0 1px rgba(212,175,55,0.45);\n  transition:background .45s var(--spring), box-shadow .45s var(--spring);\n}\n.vq-led .on { display:none; }\n.vq-bay:hover .vq-led, .vq-bay:focus-visible .vq-led { color:var(--green); }\n.vq-bay:hover .vq-led::before, .vq-bay:focus-visible .vq-led::before { background:var(--green); box-shadow:0 0 12px var(--green), 0 0 0 1px rgba(63,185,80,0.6); }\n.vq-bay:hover .vq-led .on, .vq-bay:focus-visible .vq-led .on { display:inline; }\n.vq-bay:hover .vq-led .off, .vq-bay:focus-visible .vq-led .off { display:none; }\n\n.vq-q {\n  font-family:var(--font-display); font-size:clamp(21px,2.05vw,31px); line-height:1.12;\n  letter-spacing:-0.3px; color:var(--text); text-wrap:balance; margin-bottom:clamp(13px,2vh,19px);\n}\n.vq-read { display:flex; flex-direction:column; gap:8px; margin-top:auto; }\n.vq-row {\n  display:grid; grid-template-columns:auto 1fr; gap:10px; align-items:baseline;\n  padding:9px 11px; border-radius:9px; border:1px solid var(--border); background:var(--code-bg);\n  transition:border-color .45s var(--spring), box-shadow .45s var(--spring), opacity .45s var(--spring);\n}\n.vq-mk { font-family:var(--font-mono); font-size:12px; font-weight:800; }\n.vq-tx { font-family:var(--font-editorial); font-size:clamp(12.5px,1.15vw,15.5px); line-height:1.38; color:var(--text-dim); transition:color .45s var(--spring); }\n.vq-row.bad  { border-color:rgba(248,81,73,0.28); }\n.vq-row.bad .vq-mk  { color:var(--red); }\n.vq-row.good { border-color:rgba(63,185,80,0.26); opacity:0.5; }\n.vq-row.good .vq-mk { color:var(--green); }\n.vq-bay:hover .vq-row.bad, .vq-bay:focus-visible .vq-row.bad { opacity:0.38; }\n.vq-bay:hover .vq-row.good, .vq-bay:focus-visible .vq-row.good { opacity:1; border-color:var(--green); box-shadow:0 0 24px -6px rgba(63,185,80,0.5); }\n.vq-bay:hover .vq-row.good .vq-tx, .vq-bay:focus-visible .vq-row.good .vq-tx { color:var(--text); }\n\n.vq-when {\n  display:flex; align-items:center; gap:8px;\n  margin-top:clamp(12px,1.8vh,16px); padding-top:clamp(10px,1.5vh,13px); border-top:1px solid var(--border);\n  font-family:var(--font-mono); font-size:clamp(9px,0.85vw,10.5px); letter-spacing:1.4px;\n  text-transform:uppercase; color:var(--text-dim); opacity:0.8;\n}\n.vq-when b { color:var(--gold); font-weight:700; transition:color .45s var(--spring); }\n.vq-bay:hover .vq-when b, .vq-bay:focus-visible .vq-when b { color:var(--green); }\n\n@media (prefers-reduced-motion: reduce) {\n  .vq-bay, .vq-row, .vq-n, .vq-led, .vq-led::before, .vq-tx, .vq-when b, .vq-brk { transition:none !important; }\n  .vq-bay:hover, .vq-bay:focus-visible { transform:none; }\n  .vq-row.good { opacity:1; }\n}\n/* ── SILHOUETTE FOG — a named star with a closed interior (Act 3A) ───── */\n.fog { position:relative; overflow:hidden; border-radius:14px; }\n.fog-inner { filter:blur(6px) saturate(0.45); opacity:0.42; user-select:none; }\n.fog::after {\n  content:''; position:absolute; inset:0; pointer-events:none;\n  background:\n    repeating-linear-gradient(135deg, rgba(34,211,238,0.045) 0 11px, transparent 11px 22px),\n    radial-gradient(ellipse at 50% 50%, rgba(8,8,10,0.42), rgba(8,8,10,0.86) 82%);\n}\n.fog-seal {\n  position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); z-index:2;\n  display:flex; flex-direction:column; align-items:center; gap:7px; text-align:center;\n  width:88%; pointer-events:none;\n}\n.fog-seal .fs-lock { font-family:var(--font-mono); font-size:clamp(9px,0.85vw,11px); font-weight:800; letter-spacing:2.4px; text-transform:uppercase; color:var(--cyan); opacity:0.9; }\n.fog-seal .fs-line { font-family:var(--font-display); font-style:italic; font-size:clamp(14px,1.5vw,20px); line-height:1.25; color:var(--text); }\n\n/* ── VQ bay, permanently powered on — the Act 3B callback ───────────── */\n.vq-bay--on { border-color:rgba(63,185,80,0.5); box-shadow:inset 0 1px 0 rgba(255,255,255,0.07), 0 0 40px -12px rgba(63,185,80,0.55); }\n.vq-bay--on .vq-brk { border-color:var(--green); }\n.vq-bay--on .vq-n { background:var(--green); box-shadow:0 4px 14px rgba(63,185,80,0.45), inset 0 1px 0 rgba(255,255,255,0.3); }\n.vq-bay--on .vq-led { color:var(--green); }\n.vq-bay--on .vq-led::before { background:var(--green); box-shadow:0 0 12px var(--green), 0 0 0 1px rgba(63,185,80,0.6); }\n.vq-bay--on .vq-led .on { display:inline; }\n.vq-bay--on .vq-led .off { display:none; }\n.vq-bay--on .vq-row.bad { opacity:0.32; }\n.vq-bay--on .vq-row.good { opacity:1; border-color:var(--green); box-shadow:0 0 24px -6px rgba(63,185,80,0.5); }\n.vq-bay--on .vq-row.good .vq-tx { color:var(--text); }\n.vq-bay--on .vq-when b { color:var(--green); }\n\n/* ── WITHHOLD MATRIX — one row per removed channel (Act 3B) ─────────── */\n.wh-row {\n  display:grid; grid-template-columns:clamp(150px,15vw,230px) 1fr clamp(190px,19vw,290px);\n  gap:clamp(10px,1.2vw,20px); align-items:center;\n  padding:clamp(9px,1.4vh,14px) clamp(13px,1.2vw,20px);\n  border:1px solid var(--border-bright); border-left:3px solid var(--red); border-radius:11px;\n  background:linear-gradient(90deg, rgba(248,81,73,0.07), var(--surface) 62%);\n}\n.wh-row--all { border-left-color:var(--green); background:linear-gradient(90deg, rgba(63,185,80,0.09), var(--surface) 62%); border-color:rgba(63,185,80,0.4); }\n.wh-lbl { font-family:var(--font-mono); font-size:clamp(9.5px,0.9vw,11.5px); letter-spacing:1.6px; text-transform:uppercase; color:var(--text-dim); }\n.wh-chan { display:flex; flex-wrap:wrap; gap:6px; }\n.wh-ch {\n  font-family:var(--font-mono); font-size:clamp(9px,0.86vw,11px); letter-spacing:0.6px;\n  padding:4px 9px; border-radius:5px; border:1px solid var(--border-bright); color:var(--text-dim);\n  background:rgba(255,255,255,0.03);\n}\n.wh-ch.live { color:#a8e6b4; border-color:rgba(63,185,80,0.45); background:rgba(63,185,80,0.10); }\n.wh-ch.gone { color:var(--red); border-color:rgba(248,81,73,0.5); background:rgba(248,81,73,0.10); text-decoration:line-through; text-decoration-thickness:1.5px; }\n.wh-verd { font-family:var(--font-mono); font-size:clamp(9px,0.88vw,11.5px); font-weight:800; letter-spacing:1.2px; text-align:right; color:var(--red); }\n.wh-row--all .wh-verd { color:var(--green); }\n@media (max-width: 900px) { .wh-row { grid-template-columns:1fr; } .wh-verd { text-align:left; } }\n/* ── LEDGER — the transformation table (Act 4 slide 65) ─────────────── */\n.lg-head {\n  display:grid; grid-template-columns:var(--lg-cols); gap:clamp(11px,1.3vw,24px);\n  align-items:end; padding:0 clamp(15px,1.4vw,24px) clamp(8px,1.3vh,12px);\n  border-bottom:1px solid var(--border-bright);\n}\n.lg-h {\n  font-family:var(--font-mono); font-size:clamp(8.5px,0.82vw,10.5px); font-weight:800;\n  letter-spacing:2.2px; text-transform:uppercase; color:var(--text-dim); opacity:0.75;\n}\n.lg-h em { display:block; font-family:var(--font-editorial); font-style:italic; font-size:1.25em;\n  letter-spacing:0; text-transform:none; font-weight:400; opacity:0.8; margin-top:3px; }\n\n.lg-row {\n  display:grid; grid-template-columns:var(--lg-cols); gap:clamp(11px,1.3vw,24px);\n  align-items:center; position:relative; overflow:hidden;\n  padding:clamp(9px,1.4vh,14px) clamp(15px,1.4vw,24px);\n  border:1px solid var(--border); border-left:3px solid var(--lg-c, var(--silver));\n  border-radius:13px;\n  background:linear-gradient(90deg, var(--lg-fill, rgba(176,190,197,0.05)), var(--surface) 62%);\n  transition:transform .5s var(--spring), box-shadow .5s var(--spring), border-color .5s var(--spring);\n}\n.lg-row::after { /* corner halo in the row's colour */\n  content:''; position:absolute; top:-70px; right:-70px; width:200px; height:200px;\n  background:radial-gradient(circle, var(--lg-halo, transparent), transparent 70%);\n  pointer-events:none;\n}\n.lg-row > * { position:relative; z-index:1; }\n.lg-row:hover { transform:translateX(4px); border-color:var(--lg-c, var(--silver));\n  box-shadow:0 12px 34px -18px rgba(0,0,0,0.7), 0 0 34px -14px var(--lg-halo, transparent); }\n.lg-row--hero { border-width:1px; border-color:var(--lg-c); box-shadow:0 0 36px -16px var(--lg-halo); }\n\n.lg-name { font-family:var(--font-display); font-size:clamp(15px,1.5vw,21px); line-height:1.08; color:var(--text); }\n.lg-sub {\n  font-family:var(--font-mono); font-size:clamp(8.5px,0.82vw,10.5px); letter-spacing:1.3px;\n  text-transform:uppercase; color:var(--text-dim); opacity:0.72; margin-top:5px;\n}\n.lg-was {\n  display:inline-block;\n  font-family:var(--font-numeric); font-size:clamp(14px,1.45vw,20px); color:var(--text-dim);\n  text-decoration-line:line-through; text-decoration-color:rgba(248,81,73,0.75); text-decoration-thickness:2px;\n  white-space:nowrap;\n}\n/* the qualifier sits OUTSIDE the struck value, so the rule never crosses it */\n.lg-wasu { font-family:var(--font-mono); font-size:clamp(8px,0.76vw,9.5px); letter-spacing:0.9px;\n  text-transform:uppercase; color:var(--text-dim); opacity:0.6; margin-top:4px; white-space:nowrap; }\n.lg-now { font-family:var(--font-numeric); font-size:clamp(17px,1.75vw,25px); color:var(--text); white-space:nowrap; }\n.lg-now small { font-family:var(--font-mono); font-size:0.5em; letter-spacing:0.6px; display:block; margin-top:3px; color:var(--text-dim); }\n\n/* the ratio pair — two micro-bars whose lengths ARE the measured ratio */\n.lg-bars { display:flex; flex-direction:column; gap:5px; min-width:0; }\n.lg-track { position:relative; height:5px; border-radius:3px; background:rgba(255,255,255,0.045); overflow:hidden; }\n.lg-track i { position:absolute; inset:0 auto 0 0; border-radius:3px; display:block; }\n.lg-track--was i { background:linear-gradient(90deg, rgba(248,81,73,0.85), rgba(248,81,73,0.3)); width:100%; }\n.lg-track--now i {\n  min-width:7px; /* a 1% ratio must still read as a deliberate mark, not as nothing */\n  background:linear-gradient(90deg, #3fb950, rgba(63,185,80,0.45));\n  box-shadow:0 0 14px -1px rgba(63,185,80,0.9), 0 0 0 1px rgba(63,185,80,0.35);\n}\n.lg-legend { font-family:var(--font-mono); font-size:clamp(7.5px,0.72vw,9px); letter-spacing:1.4px; text-transform:uppercase; color:var(--text-dim); opacity:0.55; margin-top:2px; }\n\n.lg-gain {\n  justify-self:end; font-family:var(--font-numeric); font-weight:700;\n  font-size:clamp(14px,1.5vw,21px); letter-spacing:-0.3px; color:#000;\n  background:var(--lg-c, var(--silver)); padding:clamp(5px,0.85vh,8px) clamp(10px,1vw,16px);\n  border-radius:8px; white-space:nowrap;\n  box-shadow:0 5px 18px -6px var(--lg-halo, rgba(0,0,0,0.4)), inset 0 1px 0 rgba(255,255,255,0.32);\n}\n.lg-gain--soft {\n  color:var(--lg-c, var(--silver)); background:transparent;\n  border:1px solid var(--lg-c, var(--silver)); box-shadow:none;\n  font-size:clamp(13px,1.35vw,19px);\n}\n.lg-gain--note { color:var(--lg-c); background:transparent; border:1px dashed var(--lg-c);\n  box-shadow:none; font-family:var(--font-editorial); font-style:italic; font-weight:400;\n  font-size:clamp(11px,1.1vw,15px); letter-spacing:0; }\n@media (max-width: 1100px) {\n  .lg-head { display:none; }\n  .lg-row { grid-template-columns:1fr; row-gap:8px; }\n  .lg-gain { justify-self:start; }\n}\n.lg-body { display:flex; flex-direction:column; gap:clamp(7px,1.15vh,12px); margin-top:clamp(9px,1.5vh,14px); }\n.lg-foot { margin-bottom:clamp(52px,7.5vh,80px); }\n/* short projectors (1366×768 and friends): shed the nice-to-haves, keep the table */\n@media (max-height: 820px) {\n  .lg-h em { display:none; }\n  .lg-legend { display:none; }\n  .lg-row { padding-top:8px; padding-bottom:8px; }\n  .lg-name { font-size:clamp(14px,1.4vw,18px); }\n  .lg-sub { margin-top:3px; }\n  .lg-body { gap:6px; margin-top:9px; }\n  .lg-foot { margin-bottom:42px; }\n  .lg-foot .callout { padding:clamp(11px,1.5vh,15px) clamp(14px,1.3vw,20px); }\n  .lg-aside { display:none; }\n}\n</style>\n</head>\n<body class=\"anim-ready\">\n\n<!-- fundo vivo global — aurora fixa + grid-floor -->\n<div class=\"atmosphere\" aria-hidden=\"true\">\n  <div class=\"aurora\"><b></b></div>\n  <div class=\"grid-floor\"></div>\n</div>\n\n<!-- chrome de navegação -->\n<div class=\"deck-progress\" aria-hidden=\"true\"></div>\n<div class=\"deck-counter\" id=\"hud\" aria-hidden=\"true\" style=\"--dc-c: var(--purple); --dc-glow: rgba(167,139,250,0.45);\">\n  <div class=\"dc-top\">\n    <span class=\"dc-act\" id=\"dcAct\">OPENING</span>\n    <span class=\"dc-pos\"><span class=\"dc-n\" id=\"n\">01</span><span class=\"dc-sep\">/</span><span class=\"dc-tot\" id=\"total\">80</span></span>\n  </div>\n  <div class=\"dc-name\" id=\"dcName\">Dark Factory Operation</div>\n  <div class=\"dc-bar\" id=\"dcBar\"><span class=\"dc-seg current\"></span><span class=\"dc-seg\"></span><span class=\"d