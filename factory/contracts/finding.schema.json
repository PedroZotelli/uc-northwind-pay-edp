{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northwindpay.local/dark-factory/finding.schema.json",
  "title": "Dark Factory privacy-safe source-control finding",
  "description": "Closed contract for one read-only finding. Unknown members are rejected everywhere. Money is text because a JSON number cannot carry an exact cent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval",
    "attribution",
    "batch",
    "continuation",
    "controls",
    "created_at",
    "finding_code",
    "finding_id",
    "finding_version",
    "isolation",
    "method",
    "observations",
    "references",
    "remediation",
    "scenario",
    "schema_version",
    "terminal"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "finding_version": { "type": "integer", "const": 1 },
    "finding_code": { "enum": ["DF-SOURCE-CONTROL-MISMATCH"] },
    "finding_id": { "$ref": "#/$defs/digest" },
    "scenario": {
      "enum": [
        "DF-SOURCE-001",
        "DF-SOURCE-002",
        "DF-SOURCE-003",
        "DF-SOURCE-004",
        "DF-SOURCE-005"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Runtime-supplied UTC instant. Excluded from finding identity."
    },

    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "contract_code",
        "contract_version",
        "layout_version",
        "type_number"
      ],
      "properties": {
        "batch_id": { "$ref": "#/$defs/batchId" },
        "type_number": { "enum": ["01", "02", "03", "04", "05"] },
        "contract_code": { "type": "string", "pattern": "^[A-Z0-9_]{1,16}$" },
        "contract_version": { "type": "integer", "minimum": 1 },
        "layout_version": { "type": "string", "pattern": "^[0-9]{3}$" }
      }
    },

    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compared", "difference_count"],
      "properties": {
        "difference_count": { "type": "integer", "minimum": 1 },
        "compared": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "computed",
              "control",
              "declared",
              "matches",
              "value_class"
            ],
            "properties": {
              "control": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,48}$" },
              "value_class": { "enum": ["count", "money"] },
              "declared": { "$ref": "#/$defs/controlValue" },
              "computed": { "$ref": "#/$defs/controlValue" },
              "matches": { "type": "boolean" }
            }
          }
        }
      }
    },

    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "status"],
      "properties": {
        "status": { "enum": ["quarantined"] },
        "stage": { "enum": ["java-validation"] },
        "code": {
          "enum": [
            "SOURCE_CONTROL_TOTAL_MISMATCH",
            "SOURCE_CONTROL_NET_MISMATCH",
            "SOURCE_CONTROL_ASSESSED_FEE_MISMATCH"
          ]
        }
      }
    },

    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_row_count",
        "observed",
        "postgres_business_mutation",
        "quarantine_scope",
        "raw_quarantine_present",
        "sanitized_csv_present",
        "staging_row_count"
      ],
      "properties": {
        "observed": { "type": "boolean" },
        "quarantine_scope": { "enum": ["batch"] },
        "raw_quarantine_present": { "type": "boolean" },
        "sanitized_csv_present": { "type": "boolean" },
        "postgres_business_mutation": { "type": "boolean" },
        "staging_row_count": { "type": "integer", "minimum": 0 },
        "business_row_count": { "type": "integer", "minimum": 0 }
      }
    },

    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "peers"],
      "properties": {
        "observed": { "type": "boolean" },
        "peers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["batch_id", "reconciliation_status", "status"],
            "properties": {
              "batch_id": { "$ref": "#/$defs/batchId" },
              "status": { "enum": ["succeeded", "quarantined", "oracle_mismatch"] },
              "reconciliation_status": { "enum": ["MATCHED", "MISMATCHED", "ABSENT"] }
            }
          }
        }
      }
    },

    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "confidence", "owner"],
      "properties": {
        "owner": { "enum": ["source_system_of_record", "undetermined"] },
        "confidence": { "enum": ["conclusive", "inconclusive"] },
        "basis": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channels", "rule", "satisfied"],
            "properties": {
              "rule": {
                "enum": [
                  "declaration-source-owned-and-consistent",
                  "independent-computation-agreement",
                  "declared-differs-from-computed"
                ]
              },
              "channels": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/channel" }
              },
              "satisfied": { "type": "boolean" }
            }
          }
        }
      }
    },

    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "detector", "detector_version"],
      "properties": {
        "detector": { "const": "northwind-pay-dark-factory-source-control-detector" },
        "detector_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "comparison": { "const": "declared-versus-independently-computed-controls" }
      }
    },

    "observations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "independence", "reference", "role"],
        "properties": {
          "channel": { "$ref": "#/$defs/channel" },
          "role": {
            "enum": [
              "system_of_record",
              "source_of_observation",
              "source_of_correctness"
            ]
          },
          "independence": {
            "enum": [
              "source_declaration",
              "independent_computation",
              "persisted_record",
              "derived_projection",
              "transport_observation",
              "contract_comparison"
            ]
          },
          "reference": { "$ref": "#/$defs/digest" }
        }
      }
    },

    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_oracle_sha256",
        "detector_source_sha256",
        "raw_sha256",
        "source_manifest_sha256"
      ],
      "properties": {
        "raw_sha256": { "$ref": "#/$defs/digest" },
        "source_manifest_sha256": { "$ref": "#/$defs/digest" },
        "contract_oracle_sha256": { "$ref": "#/$defs/digest" },
        "detector_source_sha256": { "$ref": "#/$defs/digest" }
      }
    },

    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": { "state": { "const": "not_requested" } }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": { "state": { "const": "not_requested" } }
    }
  },

  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "batchId": { "type": "string", "pattern": "^B[0-9]{15}$" },
    "controlValue": { "type": "string", "pattern": "^(-?[0-9]+\\.[0-9]{2}|[0-9]{1,9})$" },
    "channel": {
      "enum": [
        "legacy-source-manifest",
        "legacy-java-processor",
        "legacy-postgres-diagnostic",
        "legacy-postgres-control-plane",
        "legacy-sftp-transport",
        "legacy-contract-oracle"
      ]
    }
  }
}
